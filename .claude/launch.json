{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rassmatours-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "rassmatours-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 5175
    },
    {
      "name": "rassmatours-netlify",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.nvm/versions/node/v22.23.1/bin:$PATH\"; exec npx -y netlify-cli@27.17.0 dev --offline"
      ],
      "port": 8888
    }
  ]
}
