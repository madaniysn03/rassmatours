# Serveur du site Rassma Tours (image frontend). ${API_UPSTREAM} est remplacé au démarrage du conteneur.

# Derrière un autre proxy HTTPS (Caddy, Traefik, Cloudflare…), on garde le protocole d'origine.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Redirections relatives : correctes quel que soit le port ou le proxy devant.
  absolute_redirect off;
  server_tokens off;

  gzip on;
  gzip_types text/css application/javascript text/javascript application/json image/svg+xml application/xml text/plain;
  gzip_min_length 1024;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # Anciennes URL : redirections 301 générées depuis dist/_redirects au build de l'image.
  include /etc/nginx/redirects.conf;

  # API : relayée vers le conteneur backend-api.
  location /api/ {
    resolver ${DNS_RESOLVER} valid=30s ipv6=off;
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 10m;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
    try_files $uri =404;
  }
  location /fonts/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
    try_files $uri =404;
  }
  location /images/ {
    add_header Cache-Control "public, max-age=2592000";
    add_header X-Content-Type-Options nosniff always;
    try_files $uri =404;
  }
  location /admin/ {
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "no-store";
    add_header X-Content-Type-Options nosniff always;
    try_files $uri $uri/ =404;
  }

  # Pages prérendues : /tours -> 301 /tours/ (dossier), /tours/ -> tours/index.html, sinon vraie 404.
  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    try_files $uri $uri/ =404;
  }

  error_page 404 /404.html;
  location = /404.html {
    internal;
  }
}
