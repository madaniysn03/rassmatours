{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    { "source": "/experiences", "destination": "/tours/", "permanent": true },
    { "source": "/experiences/tangier-highlights", "destination": "/tours/cap-spartel-hercules-caves/", "permanent": true },
    { "source": "/experiences/:slug", "destination": "/tours/:slug/", "permanent": true },
    { "source": "/tours/tangier-highlights", "destination": "/tours/cap-spartel-hercules-caves/", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
