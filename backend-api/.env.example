# Serveur de l'API Rassma Tours. Copier en .env et renseigner. Jamais versionné.

# Port d'écoute (derrière nginx/Apache, garder un port interne).
PORT=3001
# Adresse d'écoute : 127.0.0.1 derrière un reverse proxy, 0.0.0.0 pour exposer directement.
HOST=127.0.0.1

# Mot de passe de /admin/ (12 caractères ou plus). Sans lui, l'admin est désactivé.
ADMIN_PASSWORD=
# Clé de signature des sessions : longue chaîne aléatoire (openssl rand -base64 32). La changer déconnecte tout le monde.
ADMIN_SESSION_SECRET=

# Base PostgreSQL (recommandé en production) : postgres://utilisateur:motdepasse@hote:5432/base
# Vide : stockage en fichiers dans DATA_DIR.
DATABASE_URL=
# Mettre 1 si la base exige une connexion chiffrée (base hébergée hors du serveur).
DATABASE_SSL=0

# Dossier des données si DATABASE_URL est vide (messages, galerie, photos). À sauvegarder régulièrement.
DATA_DIR=./data

# Site sur un autre domaine que l'API : origines autorisées (CORS avec cookies), séparées par des virgules.
# Ex. : https://rassmatours.com,https://www.rassmatours.com
ALLOWED_ORIGINS=

# Optionnel : chemin du site construit (frontend/dist) pour que ce serveur serve aussi les pages.
# Laisser vide si nginx/Apache sert le site et ne relaie que /api/ vers ce serveur.
FRONTEND_DIR=

# Mettre 1 derrière un reverse proxy (nginx, Apache, Cloudflare) pour lire l'IP et le protocole d'origine.
TRUST_PROXY=0

# Limite d'envois du formulaire de contact par adresse IP (par tranche de 10 minutes).
INQUIRY_RATE_LIMIT=5
